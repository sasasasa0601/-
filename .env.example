# Supabase プロジェクト設定
#
# URL は Supabase ダッシュボードのアドレスバーにあるプロジェクト ref から組み立てます。
#   supabase.com/dashboard/project/<ここがref>/...
#   → https://<ここがref>.supabase.co
# Project Settings > Data API にも同じものが表示されます。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Project Settings > API Keys から。次のどちらでも動きます。
#   sb_publishable_...  新しい Publishable key（推奨）
#   eyJhbGciOi...       旧 anon public key（Legacy タブ）
#
# どちらもブラウザに露出する公開値で、RLS が守ります。
# sb_secret_... / service_role キーは RLS を貫通するので絶対に置かないでください。
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
